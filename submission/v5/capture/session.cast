[28.744361, "o", "Порядок: оставить / улучшить / сменить фокус / закрыть. Точные Decimal-расчёты:\r\n"]
[28.744478, "o", "Веса 0.3/0.3/0.4\r\nOPT-001=2.8; OPT-002=3.3; OPT-003=2.3; OPT-004=1.5; лидер OPT-002\r\nВеса 0.5/0.3/0.2\r\nOPT-001=3.4; OPT-002=3.5; OPT-003=2.5; OPT-004=2.3; лидер OPT-002\r\n"]
[28.744546, "o", "Веса 0.2/0.3/0.5\r\nOPT-001=2.5; OPT-002=3.2; OPT-003=2.2; OPT-004=1.1; лидер OPT-002\r\nОШИБКА V4: 3.3 вместо 3.5 во втором сценарии; смены лидера в этих трёх сценариях НЕТ.\r\nЭто не устойчивость при любых весах и не доказательство спроса. Баллы учебные.\r\n"]
