{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:strategist:media-extraction","type":"object","additionalProperties":false,
 "required":["format","status","engine","segments","coverage","children","limitations"],
  "properties":{
    "format":{"enum":["image","scan_pdf","audio","video"]},
    "status":{"enum":["ok","partial"]},
    "engine":{"type":"object","minProperties":1},
    "segments":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,"required":["kind","coordinates","text","uncertain","confidence"],
      "properties":{"kind":{"enum":["image","audio","video"]},"coordinates":{"type":"object"},"text":{"type":"string","minLength":1},"uncertain":{"type":"boolean"},"confidence":{"type":["number","null"],"minimum":0,"maximum":100}},
      "allOf":[
        {"if":{"properties":{"kind":{"const":"image"}}},"then":{"properties":{"coordinates":{"$ref":"#/$defs/image"}}}},
        {"if":{"properties":{"kind":{"const":"audio"}}},"then":{"properties":{"coordinates":{"$ref":"#/$defs/audio"}}}},
        {"if":{"properties":{"kind":{"const":"video"}}},"then":{"properties":{"coordinates":{"$ref":"#/$defs/video"}}}}
      ]
    }},
    "coverage":{"type":"object"},
    "children":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["sha256","media_type","mapping","artifact_ref"],"properties":{"sha256":{"$ref":"urn:strategist:common#/$defs/hash"},"media_type":{"enum":["image/png","audio/wav"]},"mapping":{"type":"object","minProperties":1},"artifact_ref":{"$ref":"urn:strategist:common#/$defs/ref"}}}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "$defs":{
    "ms":{"type":"integer","minimum":0,"maximum":120000},
    "image":{"type":"object","additionalProperties":false,"required":["bbox","width","height","orientation"],"properties":{"bbox":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":0}},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"orientation":{"const":"top_left_pixels"},"physical_page":{"type":"integer","minimum":1,"maximum":100}}},
    "audio":{"type":"object","additionalProperties":false,"required":["start_ms","end_ms","speaker"],"properties":{"start_ms":{"$ref":"#/$defs/ms"},"end_ms":{"$ref":"#/$defs/ms"},"speaker":{"const":"unknown"}}},
    "video":{"type":"object","additionalProperties":false,"required":["timestamp_ms","frame_index","frame_sha256"],"properties":{"timestamp_ms":{"$ref":"#/$defs/ms"},"frame_index":{"type":"integer","minimum":0},"frame_sha256":{"$ref":"urn:strategist:common#/$defs/hash"}}}
  }
}
