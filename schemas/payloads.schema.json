{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:strategist:payloads",
 "$defs":{
  "brief":{"type":"object","additionalProperties":false,"required":["goal","constraints","open_questions"],"properties":{"goal":{"type":"string","minLength":1},"constraints":{"type":"array","items":{"type":"string"}},"open_questions":{"type":"array","items":{"type":"string"}}}},
  "question":{"type":"object","additionalProperties":false,"required":["text","affected_choice","priority"],"properties":{"text":{"type":"string","minLength":1},"affected_choice":{"type":"string","minLength":1},"priority":{"enum":["high","medium","low"]}}},
  "link":{"type":"object","additionalProperties":false,"required":["from_ref","to_ref","relation"],"properties":{"from_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"to_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"relation":{"enum":["evidence","derivation","contradicts","related_to","supersedes"]}}},
  "option":{"type":"object","required":["option_type","mechanism","audience","basis_refs","strongest_objection","minimal_test"],"properties":{"option_type":{"enum":["status_quo","improve","refocus","close"]},"mechanism":{"type":"string","minLength":1},"audience":{"type":"string","minLength":1},"basis_refs":{"$ref":"urn:strategist:common#/$defs/refs"},"strongest_objection":{"type":"string","minLength":1},"minimal_test":{"type":"string","minLength":1}}},
  "strategy":{"type":"object","required":["strategy_type","text","basis_refs"],"properties":{"strategy_type":{"enum":["product","communication"]},"text":{"type":"string","minLength":1},"basis_refs":{"$ref":"urn:strategist:common#/$defs/refs"}}},
  "promise":{"type":"object","required":["text","capability_status","basis_refs","qualification"],"properties":{"text":{"type":"string","minLength":1},"capability_status":{"enum":["available","planned","unknown"]},"basis_refs":{"$ref":"urn:strategist:common#/$defs/refs"},"qualification":{"type":"string"}}},
  "experiment":{"type":"object","required":["hypothesis","baseline","metric","comparison","horizon","guardrails","limitations"],"properties":{"hypothesis":{"type":"string","minLength":1},"baseline":{"type":["number","null"]},"metric":{"type":"string","minLength":1},"comparison":{"type":"string","minLength":1},"horizon":{"type":"string","minLength":1},"guardrails":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}},
  "decision":{"type":"object","additionalProperties":false,"required":["status","selected_option_ref","rejected_refs","basis_refs","strategy_refs","experiment_ref","owner","due","metrics","triggers"],"properties":{"status":{"enum":["proposed","pending","confirmed","review_required","superseded"]},"selected_option_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"rejected_refs":{"$ref":"urn:strategist:common#/$defs/refs"},"basis_refs":{"$ref":"urn:strategist:common#/$defs/refs"},"strategy_refs":{"$ref":"urn:strategist:common#/$defs/refs"},"experiment_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"owner":{"type":"string","minLength":1},"due":{"anyOf":[{"const":"unknown"},{"type":"string","format":"date-time"}]},"metrics":{"type":"array","items":{"type":"string"}},"triggers":{"type":"array","items":{"type":"string"}},"approved_proposal_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"approval_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"business_content_digest":{"$ref":"urn:strategist:common#/$defs/hash"}}},
  "action":{"type":"object","additionalProperties":false,"required":["operation"],"properties":{"operation":{"enum":["note","reserve","settle","reconcile"]},"note":{"type":"string"},"operation_key":{"type":"string","minLength":1},"attempt_id":{"type":"string","format":"uuid"},"permission_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"external":{"type":"boolean"},"adapter":{"type":"string"},"estimated_money":{"type":["number","null"],"minimum":0},"estimated_currency":{"type":["string","null"],"pattern":"^[A-Z]{3}$"},"status":{"enum":["succeeded","failed","outcome_unknown"]},"provider_request_id":{"type":["string","null"]},"evidence_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"usage":{"$ref":"urn:strategist:common#/$defs/usage"},"runtime":{"type":"object","additionalProperties":false,"properties":{"stage":{"type":"string","minLength":1},"open_questions":{"type":"array","items":{"type":"string"}},"awaiting_human":{"type":["string","null"]},"next_action":{"type":"string","minLength":1}}}}},
  "permission":{"type":"object","additionalProperties":false,"required":["scope","approval_ref","call_limit","external_allowed","money_limit","allow_unknown_money"],"properties":{"scope":{"enum":["development_resource","source_access","data_transfer"]},"approval_ref":{"$ref":"urn:strategist:common#/$defs/ref"},"call_limit":{"type":"integer","minimum":0},"external_allowed":{"type":"boolean"},"money_limit":{"type":["number","null"],"minimum":0},"currency":{"type":["string","null"],"pattern":"^[A-Z]{3}$"},"allow_unknown_money":{"type":"boolean"}}}
 }
}
