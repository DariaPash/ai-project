{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:strategist:record",
  "type":"object","required":["schema_version","case_id","id","kind","revision","previous_revision","created_at","created_by","action_id","payload","lineage_roots"],"additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},"case_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{0,63}$"},"id":{"type":"string","pattern":"^[A-Z]{3}-[0-9]{3,}$"},"kind":{"type":"string"},"revision":{"type":"integer","minimum":1},"previous_revision":{"type":["integer","null"],"minimum":1},"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","minLength":1},"action_id":{"type":"string","pattern":"^ACT-[0-9]{3,}$"},"payload":{"type":"object"},"lineage_roots":{"type":"array","items":{"$ref":"urn:strategist:common#/$defs/origin"},"minItems":1,"uniqueItems":true}
  }
}
